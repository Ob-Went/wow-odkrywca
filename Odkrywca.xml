<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Okragla pinezka: kolorowa obwodka (typ zasobu) + okragla ikona przedmiotu. -->
	<Frame name="OdkrywcaPinTemplate" mixin="OdkrywcaPinMixin" virtual="true" enableMouse="true">
		<Size x="18" y="18"/>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- ciemny cien pod spodem -->
				<Texture parentKey="Shadow" file="Interface\CharacterFrame\TempPortraitAlphaMask">
					<Anchors>
						<Anchor point="TOPLEFT" x="-1" y="1"/>
						<Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<!-- kolorowa obwodka -->
				<Texture parentKey="Ring" file="Interface\CharacterFrame\TempPortraitAlphaMask" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-2"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
					</Anchors>
				</Texture>
				<MaskTexture parentKey="IconMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Icon"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="OVERLAY">
				<!-- rozjasnienie po najechaniu myszka -->
				<Texture parentKey="Highlight" file="Interface\CharacterFrame\TempPortraitAlphaMask" alphaMode="ADD" hidden="true" setAllPoints="true">
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>
</Ui>
